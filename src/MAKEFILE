# Turbo C 2.0: small model, explicitly 8086/8088, no floating point.
CC=tcc
CFLAGS=-1- -ms -O -Z -w -IC:\TC\INCLUDE -LC:\TC\LIB

# -1- disables 80186 instructions; -ms keeps code/data near except the explicitly
# far immutable font segment. Staging removes objects before linking *.OBJ.
NW.EXE: MAIN.OBJ CORE.OBJ FSDOS.OBJ VIDEO.OBJ GRAPH.OBJ HEX.OBJ VIEW.OBJ FONT.OBJ
	$(CC) $(CFLAGS) -M -eNW.EXE *.OBJ

MAIN.OBJ: MAIN.C NW.H VERSION.H BUILD.H VIDEO.H GRAPH.H HELP.H HEX.H VIEW.H
	$(CC) $(CFLAGS) -c MAIN.C
CORE.OBJ: CORE.C NW.H VERSION.H
	$(CC) $(CFLAGS) -c CORE.C
FSDOS.OBJ: FSDOS.C NW.H VERSION.H
	$(CC) $(CFLAGS) -c FSDOS.C
VIDEO.OBJ: VIDEO.C NW.H VERSION.H VIDEO.H ASSETS.H
	$(CC) $(CFLAGS) -c VIDEO.C

GRAPH.OBJ: GRAPH.C GRAPH.H HELP.H VIDEO.H NW.H VERSION.H
	$(CC) $(CFLAGS) -c GRAPH.C

FONT.OBJ: FONT.ASM
	tasm /mx FONT.ASM

HEX.OBJ: HEX.C HEX.H
	$(CC) $(CFLAGS) -c HEX.C

VIEW.OBJ: VIEW.C VIEW.H
	$(CC) $(CFLAGS) -c VIEW.C
