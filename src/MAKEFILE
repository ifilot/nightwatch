# Turbo C 2.0: medium model (far code, near data), 8086/8088.
CC=tcc
CFLAGS=-1- -mm -O -Z -w -DZ_SOLO -DNO_GZIP -IC:\TC\INCLUDE -LC:\TC\LIB

# -1- disables 80186 instructions. Code uses separate segments; ordinary data
# stays near. Font/help and fixed decode tables live outside DGROUP.
NW.EXE: MAIN.OBJ CORE.OBJ FSDOS.OBJ VIDEO.OBJ GRAPH.OBJ HEX.OBJ VIEW.OBJ FONT.OBJ FIXED.OBJ ZIP.OBJ INFLATE.OBJ INFFAST.OBJ INFTREES.OBJ ZUTIL.OBJ ADLER32.OBJ CRC32.OBJ
	$(CC) $(CFLAGS) -M -eNW.EXE *.OBJ

MAIN.OBJ: MAIN.C NW.H ZIP.H VERSION.H BUILD.H VIDEO.H GRAPH.H HELP.H HEX.H VIEW.H
	$(CC) $(CFLAGS) -c MAIN.C
CORE.OBJ: CORE.C NW.H VERSION.H
	$(CC) $(CFLAGS) -c CORE.C
FSDOS.OBJ: FSDOS.C NW.H VERSION.H
	$(CC) $(CFLAGS) -c FSDOS.C
VIDEO.OBJ: VIDEO.C NW.H VERSION.H VIDEO.H ASSETS.H
	$(CC) $(CFLAGS) -c VIDEO.C

GRAPH.OBJ: GRAPH.C GRAPH.H HELP.H VIDEO.H NW.H VERSION.H
	$(CC) $(CFLAGS) -c GRAPH.C

FONT.OBJ: FONT.ASM
	tasm /mx FONT.ASM
FIXED.OBJ: FIXED.ASM
	tasm /mx FIXED.ASM

HEX.OBJ: HEX.C HEX.H
	$(CC) $(CFLAGS) -c HEX.C

VIEW.OBJ: VIEW.C VIEW.H
	$(CC) $(CFLAGS) -c VIEW.C

ZIP.OBJ: ZIP.C ZIP.H NW.H ZLIB.H
	$(CC) $(CFLAGS) -c ZIP.C
INFLATE.OBJ: INFLATE.C
	$(CC) $(CFLAGS) -c INFLATE.C
INFFAST.OBJ: INFFAST.C
	$(CC) $(CFLAGS) -c INFFAST.C
INFTREES.OBJ: INFTREES.C
	$(CC) $(CFLAGS) -c INFTREES.C
ZUTIL.OBJ: ZUTIL.C
	$(CC) $(CFLAGS) -c ZUTIL.C
ADLER32.OBJ: ADLER32.C
	$(CC) $(CFLAGS) -c ADLER32.C
CRC32.OBJ: CRC32.C
	$(CC) $(CFLAGS) -c CRC32.C
